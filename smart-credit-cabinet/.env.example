# Скопируйте в .env и поменяйте значения для своего стенда. Без .env используются демо-значения из docker-compose.yml.

# PostgreSQL
DB_NAME=credit
DB_USER=credit
DB_PASSWORD=change-me

# Секрет подписи JWT (HS256), не короче 32 символов
APP_JWT_SECRET=change-me-to-a-random-string-of-32-plus-chars

# Пауза между шагами конвейера, мс: на демо видно, как заявка проходит проверки
PIPELINE_STEP_DELAY_MS=1500

# Загрузить демо-компании и тестовых пользователей при первом старте
SEED_DEMO_DATA=true

# Пароль тестовых аккаунтов для кнопок быстрого входа (пусто — кнопки только подставляют логин)
VITE_DEMO_PASSWORD=demo
