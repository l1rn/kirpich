  "components": {
    "schemas": {
      "RecommendationRequest": {
        "type": "object",
        "properties": {
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "amount": {
            "type": "integer",
            "format": "int64",
            "exclusiveMinimum": 0
          },
          "urgent": {
            "type": "boolean"
          }
        },
        "required": [
          "purpose"
        ]
      },
      "Product": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "purposes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "minAmount": {
            "type": "integer",
            "format": "int64"
          },
          "maxAmount": {
            "type": "integer",
            "format": "int64"
          },
          "minTerm": {
            "type": "integer",
            "format": "int32"
          },
          "maxTerm": {
            "type": "integer",
            "format": "int32"
          },
          "baseRate": {
            "type": "number",
            "format": "double"
          },
          "revenueRatio": {
            "type": "number",
            "format": "double"
          },
          "autoApproveMax": {
            "type": "integer",
            "format": "int64"
          },
          "requiredDocuments": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "documentsRequiredAbove": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "RecommendationView": {
        "type": "object",
        "properties": {
          "product": {
            "$ref": "#/components/schemas/Product"
          },
          "suitable": {
            "type": "boolean"
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "estimatedMonthlyPayment": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "BankInfoRequest": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Item"
            },
            "minItems": 1
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "items"
        ]
      },
      "Item": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "pattern": "TEXT|FILE"
          }
        },
        "required": [
          "label",
          "type"
        ]
      },
      "BankDetailView": {
        "type": "object",
        "properties": {
          "application": {
            "$ref": "#/components/schemas/DetailView"
          },
          "company": {
            "$ref": "#/components/schemas/CompanyView"
          },
          "assignee": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SourceView"
            }
          },
          "decisions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DecisionView"
            }
          },
          "infoRequests": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InfoRequestView"
            }
          },
