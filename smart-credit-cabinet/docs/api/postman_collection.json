            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"underwriter\",\n  \"password\": \"demo\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
