                  "pm.collectionVariables.set('bankToken', pm.response.json().accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Очередь на ручной проверке",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/bank/applications?status=MANUAL_REVIEW",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bank",
                "applications"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "MANUAL_REVIEW"
                }
              ]
            },
            "description": "Чтобы очередь не была пустой, сначала подайте заявку под tishina или stroy (см. docs/test-scenarios.md).",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bankToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const rows = pm.response.json();",
                  "if (rows.length) pm.collectionVariables.set('bankApplicationId', rows[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Карточка заявки",
          "request": {
            "method": "GET",
            "header": [],
